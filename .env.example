# Local default is a JSON file in data/board.json.
# Point this at Render Postgres, or a local Docker instance, to use SQL.
# DATABASE_URL=postgres://webfpv:webfpv@127.0.0.1:5432/webfpvleaderboard

# Where the Fly button sends people. The simulator repo, not this one.
# Everything downstream concatenates onto this, so it may carry a mount
# prefix as well as a host: behind webfpv.org it is https://webfpv.org/sim.
SIM_ORIGIN=http://127.0.0.1:8000

# Public address of THIS page, written into Fly links so the simulator can
# post times back. Leave unset to use the incoming request origin, which is
# right whenever this service is the whole site. It is not right behind a
# mount prefix: a header carries a host and a host has no path, so the
# request origin comes out as https://webfpv.org, which is the landing page.
# The board's own page prefers its document.baseURI over this value for
# exactly that reason, so this is now belt and braces rather than the wiring.
# BOARD_PUBLIC_ORIGIN=https://webfpv.org/board

# Set to 1 when something else terminates TLS in front of this process, so
# x-forwarded-proto and x-forwarded-host are believed when building Fly
# links. Required on Render and behind any https reverse proxy. Leave unset
# when the process is reachable directly: the headers are client supplied
# and are only trusted because this says a proxy sets them.
# BOARD_TRUST_PROXY=1

PORT=3100

# Optional. When set, listing and updating bug tickets needs
# Authorization: Bearer <token>. Testers can still submit without it.
# BUGS_TOKEN=
